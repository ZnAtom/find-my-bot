# FoundIt server-style environment template
# Copy to .env on a LAN/server deployment and replace all xxx/placeholder secrets.

CASDOOR_ENDPOINT=https://auth.geekpie.club
CASDOOR_APP_NAME=foundit
CASDOOR_CLIENT_ID=xxx
CASDOOR_CLIENT_SECRET=xxx
CASDOOR_ORG=geekpie
# Casdoor 注册阶段必须验证该学校邮箱；后端登录回调会再次校验域名。
SCHOOL_EMAIL_DOMAIN=shanghaitech.edu.cn

FRONTEND_BASE_URL=http://your-host.example
CASDOOR_REDIRECT_URI=http://your-host.example/api/auth/callback
JWT_SECRET=please-generate-a-random-secret-at-least-32-chars

DB_MODE=local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=password
DB_NAME=lostfound

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
VITE_PROXY_TARGET=http://127.0.0.1:8000

AUTH_COOKIE_SECURE=0
OAUTH_STATE_EXPIRE_SECONDS=1800
CORS_ORIGINS=http://your-host.example,http://your-lan-ip,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://your-host.example,http://your-lan-ip,http://localhost:5173,http://127.0.0.1:5173

SCHOOL_API_URL=https://genaiapi.shanghaitech.edu.cn/api/v1/start
SCHOOL_VISION_MODEL=GPT-5.5
SCHOOL_API_KEY=your-school-genai-api-key
VISION_TIMEOUT_SECONDS=180
VISION_IMAGE_MAX_SIDE=1024
VISION_IMAGE_JPEG_QUALITY=75

SUPPORT_LLM_MODEL=GPT-5.5
SUPPORT_LLM_TIMEOUT_SECONDS=60
SUPPORT_DOCS_DIR=doc/support
SUPPORT_AUTO_IMPORT=1
SUPPORT_KNOWLEDGE_LIMIT=6
SUPPORT_ITEM_LIMIT=5
SUPPORT_CHAT_ANON_RATE_LIMIT_COUNT=20
SUPPORT_CHAT_AUTH_RATE_LIMIT_COUNT=60
SUPPORT_CHAT_RATE_LIMIT_WINDOW_SECONDS=3600

INSTALL_EMBEDDING_DEPS=1
EMBEDDING_ENABLED=1
EMBEDDING_MODEL_PATH=model/models--Qwen--Qwen3-VL-Embedding-2B
HF_LOCAL_ONLY=1
RETRIEVAL_CANDIDATE_LIMIT=10
BM25_WEIGHT=0.7
VECTOR_WEIGHT=0.3
VECTOR_SIMILARITY_THRESHOLD=0.48
VECTOR_SIMILARITY_MAX_DROP=0.08
RESULT_RELEVANCE_THRESHOLD=0.65

UPLOAD_RATE_LIMIT_COUNT=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
UNASSOCIATED_UPLOAD_TTL_SECONDS=3600
IMAGE_ANALYSIS_RATE_LIMIT_COUNT=10
IMAGE_ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=3600

CONTACT_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSWORD=please-use-a-long-random-backup-password

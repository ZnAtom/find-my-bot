# Render this file to deploy/nginx/foundit-local.conf before installing it:
#
#   SERVER_NAMES="localhost 127.0.0.1" \
#   BACKEND_UPSTREAM="127.0.0.1:8000" \
#   FRONTEND_UPSTREAM="127.0.0.1:5173" \
#   envsubst '$SERVER_NAMES $BACKEND_UPSTREAM $FRONTEND_UPSTREAM' \
#     < deploy/nginx/foundit-local.conf.template \
#     > deploy/nginx/foundit-local.conf
#
# The rendered *.conf file is intentionally ignored by git.

server {
    listen 80;
    server_name ${SERVER_NAMES};

    client_max_body_size 20m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/api/;
    }

    location /uploads/ {
        proxy_pass http://${BACKEND_UPSTREAM}/uploads/;
    }

    location /docs {
        proxy_pass http://${BACKEND_UPSTREAM}/docs;
    }

    location /openapi.json {
        proxy_pass http://${BACKEND_UPSTREAM}/openapi.json;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_pass http://${FRONTEND_UPSTREAM};
    }
}

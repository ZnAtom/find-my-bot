# FoundIt 通用环境变量模板
# 复制此文件为 .env 并填入实际值（.env 已被 gitignore 排除）
# 本文件只保留可迁移默认值，不写入本机 IP、绝对路径或真实密钥。

# ── Casdoor 服务地址 ──
CASDOOR_ENDPOINT=https://auth.geekpie.club
CASDOOR_APP_NAME=foundit

# ── 从 Casdoor 控制台获取 ──
CASDOOR_CLIENT_ID=xxx
CASDOOR_CLIENT_SECRET=xxx
CASDOOR_ORG=geekpie

# ── 回调地址（Casdoor 控制台需把用到的地址加入白名单） ──
# 本地开发推荐走 Vite proxy，Cookie 正常工作:
CASDOOR_REDIRECT_URI=http://localhost:5173/api/auth/callback
# 本地直连后端调试（仅 API 测试，前端登录流程会断 Cookie）:
# CASDOOR_REDIRECT_URI=http://localhost:8000/api/auth/callback
# 生产或局域网环境请复制为 .env 后改成实际域名/IP:
# CASDOOR_REDIRECT_URI=https://your-domain.example/api/auth/callback

# Casdoor 注册阶段必须验证该学校邮箱；后端登录回调会再次校验域名。
SCHOOL_EMAIL_DOMAIN=shanghaitech.edu.cn

# ── 前端地址 ──
FRONTEND_BASE_URL=http://localhost:5173

# ── JWT 签名密钥（必须至少 32 字符，建议：openssl rand -hex 32） ──
JWT_SECRET=please-generate-a-random-secret-at-least-32-chars

# ── 数据库（默认使用 docker compose db，映射到宿主机 5433） ──
DB_MODE=docker
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=appuser
DB_PASSWORD=password
DB_NAME=lostfound

# ── Cookie 安全（开发 0 / 生产 1） ──
AUTH_COOKIE_SECURE=0
OAUTH_STATE_EXPIRE_SECONDS=1800

# ── 浏览器来源白名单（逗号分隔） ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1

# ── 学校 GenAI 图片识别 ──
SCHOOL_API_URL=https://genaiapi.shanghaitech.edu.cn/api/v1/start
SCHOOL_VISION_MODEL=GPT-5.5
SCHOOL_API_KEY=your-school-genai-api-key
VISION_TIMEOUT_SECONDS=180
VISION_IMAGE_MAX_SIDE=1024
VISION_IMAGE_JPEG_QUALITY=75

# ── 通用智能客服 ──
SUPPORT_LLM_MODEL=GPT-5.5
SUPPORT_LLM_TIMEOUT_SECONDS=60
# 留空时 dev-local.sh 和后端默认读取项目内 doc/support。
SUPPORT_DOCS_DIR=
SUPPORT_AUTO_IMPORT=1
SUPPORT_KNOWLEDGE_LIMIT=6
SUPPORT_ITEM_LIMIT=5
SUPPORT_CHAT_ANON_RATE_LIMIT_COUNT=20
SUPPORT_CHAT_AUTH_RATE_LIMIT_COUNT=60
SUPPORT_CHAT_RATE_LIMIT_WINDOW_SECONDS=3600

# QQ AstrBot 只通过此服务令牌调用客服接口；生产环境请放 K8s Secret。
# 可用 openssl rand -hex 32 生成，后端和 AstrBot 插件填写同一个值。
QQ_BOT_SERVICE_TOKEN=
QQ_SUPPORT_RATE_LIMIT_COUNT=60
QQ_IMAGE_SEARCH_RATE_LIMIT_COUNT=20
QQ_IMAGE_MAX_IMAGES=3
QQ_IMAGE_MAX_PIXELS=25000000
QQ_IMAGE_SEARCH_LIMIT=5

# ── 混合检索：BM25 负责精确词汇，向量负责语义补充 ──
# 通用模板默认不加载 embedding，方便新设备先跑通服务。
# 要启用 Qwen embedding：
#   1. 把模型放到 model/models--Qwen--Qwen3-VL-Embedding-2B，或设置 EMBEDDING_MODEL_PATH
#   2. 设置 INSTALL_EMBEDDING_DEPS=1 后运行 bash dev-local.sh setup
#   3. 设置 EMBEDDING_ENABLED=1 并确保 PostgreSQL 已安装 pgvector
INSTALL_EMBEDDING_DEPS=0
EMBEDDING_ENABLED=0
EMBEDDING_MODEL_PATH=model/models--Qwen--Qwen3-VL-Embedding-2B
HF_LOCAL_ONLY=1
RETRIEVAL_CANDIDATE_LIMIT=10
BM25_WEIGHT=0.7
VECTOR_WEIGHT=0.3
VECTOR_SIMILARITY_THRESHOLD=0.48
VECTOR_SIMILARITY_MAX_DROP=0.08
RESULT_RELEVANCE_THRESHOLD=0.65

# ── 防滥用限流（每个 IP 在窗口时间内允许的次数） ──
UPLOAD_RATE_LIMIT_COUNT=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
UNASSOCIATED_UPLOAD_TTL_SECONDS=3600
IMAGE_ANALYSIS_RATE_LIMIT_COUNT=10
IMAGE_ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=3600

# ── 数据保留与加密备份 ──
CONTACT_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=30
# 生产环境不要写入 .env，建议放 K8s Secret: foundit-backup-secret/encryption_password
BACKUP_ENCRYPTION_PASSWORD=please-use-a-long-random-backup-password

# 使用 id -u 和 id -g 查看；默认 1000 适合多数本机用户。
NAPCAT_UID=1000
NAPCAT_GID=1000

# 大陆网络访问 Docker Hub 容易超时，默认走 DaoCloud DockerHub 镜像前缀。
# 如果服务器能直连 Docker Hub，可改回：
# NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
# ASTRBOT_IMAGE=soulter/astrbot:latest
NAPCAT_IMAGE=m.daocloud.io/docker.io/mlikiowa/napcat-docker:latest
ASTRBOT_IMAGE=m.daocloud.io/docker.io/soulter/astrbot:latest

# Optional: QQ number to quick-login after the first successful QR login.
# Leave empty before the account has been initialized by NapCat.
NAPCAT_ACCOUNT=
